{
  "manifest_version": 3,
  "name": "Tansakusha Collection ☺",
  "version": "0.6.28",
  "description": "Charaeno・いあきゃら・ココフォリアから探索者を統合登録。技能は高い値を保持し、SAN・画像などを項目別ルールで更新します。",
  "permissions": [
    "storage",
    "clipboardWrite",
    "scripting"
  ],
  "host_permissions": [
    "https://ccfolia.com/*",
    "https://storage.ccfolia-cdn.net/*",
    "https://charaeno.com/*",
    "https://object-storage.tyo2.conoha.io/*",
    "https://image.iaproject.app/*"
  ],
  "action": {
    "default_title": "Tansakusha Collection ☺",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' https: data: blob:;"
  },
  "background": {
    "service_worker": "background.js"
  }
}
